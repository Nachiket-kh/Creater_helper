# Local AI endpoint. Use a public endpoint in Vercel; localhost only works locally.
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b

# Twilio voice assistant (keep real credentials in an untracked .env file or Vercel settings).
TWILIO_AUTH_TOKEN=
VOICE_TRANSFER_NUMBER=+countrycodeandnumber
VOICE_WEBHOOK_BASE_URL=http://localhost:3001
VOICE_SESSION_SECRET=
