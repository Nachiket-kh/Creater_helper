DATABASE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Google OAuth web application credentials. Set the callback URL exactly as
# registered in the Google Cloud Console.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://your-app.example/api/gmail/callback
GMAIL_ALLOWED_EMAIL=creator@example.com
APP_ORIGIN=https://your-app.example
GMAIL_SESSION_SECRET=replace_with_at_least_32_random_characters
GMAIL_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Cloud Pub/Sub push subscription and daily watch renewal.
GMAIL_PUBSUB_TOPIC=projects/your-google-project/topics/collabdesk-gmail
PUBSUB_PUSH_OIDC_AUDIENCE=https://your-app.example/api/gmail/webhook
PUBSUB_PUSH_SERVICE_ACCOUNT=collabdesk-push@your-google-project.iam.gserviceaccount.com
GMAIL_CRON_SECRET=replace_with_a_long_random_secret

# Use only for a local HTTPS test environment. Production requires auth.
GMAIL_AUTH_REQUIRED=false

# Optional hosted AI for replies, workspace assistance, and voice. Gemini API
# has a free tier for selected models; create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Voice agent (optional). Local development can use:
# OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
# Vercel must use a public HTTPS Ollama-compatible endpoint; localhost is unreachable there.
OLLAMA_CHAT_URL=
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_API_KEY=
# Local browser voice demo only. The API refuses this route on Vercel.
VOICE_DEMO_ENABLED=true
TWILIO_AUTH_TOKEN=
VOICE_TRANSFER_NUMBER=
VOICE_WEBHOOK_BASE_URL=https://creater-helper.vercel.app
VOICE_SESSION_SECRET=
