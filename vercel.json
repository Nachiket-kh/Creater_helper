{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__vercel_path=:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/inbox", "destination": "/index.html" },
    { "source": "/deals", "destination": "/index.html" },
    { "source": "/deals/:id", "destination": "/index.html" },
    { "source": "/content", "destination": "/index.html" },
    { "source": "/kit", "destination": "/index.html" },
    { "source": "/voice", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/gmail/renew", "schedule": "0 3 * * *" }
  ]
}
